🇭🇰 HK VMess WS = VMess,hk1.example.com,443,auto,"3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f",transport=ws,path=/ws,host=cdn.example.com,over-tls=true,sni=hk1.example.com,skip-cert-verify=false,alterId=0,udp=true

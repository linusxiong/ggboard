mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
unified-delay: true
tcp-concurrent: true
proxies:
  - name: "剩余流量：97 GB"
    type: ss
    server: "127.0.0.1"
    port: 1080
    cipher: aes-128-gcm
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
  - name: "套餐到期：2027-01-01"
    type: ss
    server: "127.0.0.1"
    port: 1080
    cipher: aes-128-gcm
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
  - name: "距离下次重置剩余：10 天"
    type: ss
    server: "127.0.0.1"
    port: 1080
    cipher: aes-128-gcm
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
  - name: "🇭🇰 HK VMess WS"
    type: vmess
    server: hk1.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    alterId: 0
    cipher: auto
    udp: true
    tls: true
    servername: hk1.example.com
    network: ws
    ws-opts:
      path: /ws
      headers:
        Host: cdn.example.com
  - name: "JP VMess TCP"
    type: vmess
    server: "192.0.2.10"
    port: 10086
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    alterId: 0
    cipher: auto
    udp: true
  - name: "🇺🇸 US VLESS Reality"
    type: vless
    server: us1.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    flow: xtls-rprx-vision
    tls: true
    servername: www.example.org
    client-fingerprint: chrome
    reality-opts:
      public-key: PUBLIC_KEY_BASE64URL
      short-id: "0123abcd"
    network: tcp
  - name: "SG VLESS XHTTP"
    type: vless
    server: sg1.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    tls: true
    servername: sg1.example.com
    network: xhttp
    xhttp-opts:
      path: /xh
      host: x.example.com
      mode: auto
  - name: "TW VLESS WS"
    type: vless
    server: tw1.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    tls: true
    servername: tw1.example.com
    skip-cert-verify: true
    network: ws
    ws-opts:
      path: /vl
      headers:
        Host: tw1.example.com
  - name: "KR VLESS gRPC"
    type: vless
    server: kr1.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    tls: true
    servername: kr1.example.com
    network: grpc
    grpc-opts:
      grpc-service-name: vless-grpc
  - name: "HK SS obfs"
    type: ss
    server: ss.example.com
    port: 8388
    cipher: aes-128-gcm
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    plugin: obfs
    plugin-opts:
      mode: http
      host: www.example.net
  - name: "JP SS2022， Premium"
    type: ss
    server: ss2022.example.com
    port: 8389
    cipher: "2022-blake3-aes-128-gcm"
    password: "YjVkODdhNWRlMWEzNWIyMg==:M2IxYjZmNWUtN2MyYS00ZA=="
    udp: true
  - name: "SS2022 ChaCha"
    type: ss
    server: ss2022c.example.com
    port: 8390
    cipher: "2022-blake3-chacha20-poly1305"
    password: "YjVkODdhNWRlMWEzNWIyMmQwMjM0NThjNDYyMGVjYWE=:M2IxYjZmNWUtN2MyYS00ZDhlLTlmMTAtMmEzYjRjNWQ="
    udp: true
  - name: "HK SSR"
    type: ssr
    server: ssr.example.com
    port: 8443
    cipher: chacha20-ietf
    password: ssr-node-pass
    obfs: http_simple
    protocol: auth_chain_a
    obfs-param: www.example.net
    protocol-param: "7:3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
  - name: "US Trojan"
    type: trojan
    server: t1.example.com
    port: 443
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    sni: t1.example.com
  - name: "US Trojan WS"
    type: trojan
    server: t2.example.com
    port: 443
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    sni: t2.example.com
    network: ws
    ws-opts:
      path: /tj
      headers:
        Host: t2.example.com
  - name: "US Trojan gRPC"
    type: trojan
    server: t3.example.com
    port: 443
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    sni: t3.example.com
    skip-cert-verify: true
    network: grpc
    grpc-opts:
      grpc-service-name: trojan-grpc
  - name: "HK Hysteria1"
    type: hysteria
    server: hy1.example.com
    port: 36712
    auth-str: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    up: "200 Mbps"
    down: "1000 Mbps"
    protocol: udp
    obfs: obfs-pass-123
    sni: hy1.example.com
  - name: "JP Hysteria2 Hop"
    type: hysteria2
    server: hy2.example.com
    port: 20000
    ports: "20000-30000"
    hop-interval: 30
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    up: "100 Mbps"
    down: "500 Mbps"
    obfs: salamander
    obfs-password: obfs-pass-456
    sni: hy2.example.com
  - name: "SG Hysteria2"
    type: hysteria2
    server: "198.51.100.20"
    port: 8443
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    sni: hy2s.example.com
    skip-cert-verify: true
  - name: "US TUIC"
    type: tuic
    server: tuic.example.com
    port: 8443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    alpn:
      - h3
    sni: tuic.example.com
    congestion-controller: bbr
    udp-relay-mode: native
  - name: "HK AnyTLS"
    type: anytls
    server: anytls.example.com
    port: 8443
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    sni: anytls.example.com
  - name: "DE Mieru"
    type: mieru
    server: mieru.example.com
    port: 2999
    transport: TCP
    username: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    multiplexing: MULTIPLEXING_LOW
  - name: "🇺🇸 US Relay"
    type: vless
    server: relay.example.com
    port: 8443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    flow: xtls-rprx-vision
    tls: true
    servername: www.example.org
    client-fingerprint: chrome
    reality-opts:
      public-key: PUBLIC_KEY_BASE64URL
      short-id: "0123abcd"
    network: tcp
  - name: "IPv6 SS"
    type: ss
    server: "2001:db8::10"
    port: 8388
    cipher: chacha20-ietf-poly1305
    password: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
  - name: "VMess HTTP Header"
    type: vmess
    server: vh.example.com
    port: 80
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    alterId: 0
    cipher: auto
    udp: true
    network: http
    http-opts:
      method: GET
      path:
        - /index
      headers:
        Host:
          - www.example.net
  - name: "VMess HTTPUpgrade"
    type: vmess
    server: vu.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    alterId: 0
    cipher: auto
    udp: true
    tls: true
    servername: vu.example.com
    network: ws
    ws-opts:
      path: /up
      headers:
        Host: vu.example.com
      v2ray-http-upgrade: true
  - name: "VLESS H2"
    type: vless
    server: vh2.example.com
    port: 443
    uuid: "3b1b6f5e-7c2a-4d8e-9f10-2a3b4c5d6e7f"
    udp: true
    tls: true
    servername: vh2.example.com
    network: h2
    h2-opts:
      host:
        - vh2.example.com
      path: /h2
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - auto
      - "剩余流量：97 GB"
      - "套餐到期：2027-01-01"
      - "距离下次重置剩余：10 天"
      - "🇭🇰 HK VMess WS"
      - "JP VMess TCP"
      - "🇺🇸 US VLESS Reality"
      - "SG VLESS XHTTP"
      - "TW VLESS WS"
      - "KR VLESS gRPC"
      - "HK SS obfs"
      - "JP SS2022， Premium"
      - "SS2022 ChaCha"
      - "HK SSR"
      - "US Trojan"
      - "US Trojan WS"
      - "US Trojan gRPC"
      - "HK Hysteria1"
      - "JP Hysteria2 Hop"
      - "SG Hysteria2"
      - "US TUIC"
      - "HK AnyTLS"
      - "DE Mieru"
      - "🇺🇸 US Relay"
      - "IPv6 SS"
      - "VMess HTTP Header"
      - "VMess HTTPUpgrade"
      - "VLESS H2"
  - name: auto
    type: url-test
    proxies:
      - "🇭🇰 HK VMess WS"
      - "JP VMess TCP"
      - "🇺🇸 US VLESS Reality"
      - "SG VLESS XHTTP"
      - "TW VLESS WS"
      - "KR VLESS gRPC"
      - "HK SS obfs"
      - "JP SS2022， Premium"
      - "SS2022 ChaCha"
      - "HK SSR"
      - "US Trojan"
      - "US Trojan WS"
      - "US Trojan gRPC"
      - "HK Hysteria1"
      - "JP Hysteria2 Hop"
      - "SG Hysteria2"
      - "US TUIC"
      - "HK AnyTLS"
      - "DE Mieru"
      - "🇺🇸 US Relay"
      - "IPv6 SS"
      - "VMess HTTP Header"
      - "VMess HTTPUpgrade"
      - "VLESS H2"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50
rules:
  - DOMAIN,panel.example.com,DIRECT
  - MATCH,Proxy

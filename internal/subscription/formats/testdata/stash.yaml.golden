rules:
  - DOMAIN,panel.example.com,DIRECT
  - RULE-SET,ads-classical,REJECT
  - RULE-SET,ads-domain,REJECT
  - RULE-SET,lan-classical,DIRECT
  - RULE-SET,openai-classical,AI
  - RULE-SET,claude-classical,AI
  - RULE-SET,gemini-classical,AI
  - RULE-SET,telegram-classical,Telegram
  - RULE-SET,youtube-classical,Streaming
  - RULE-SET,netflix-classical,Streaming
  - RULE-SET,netflix-ip,Streaming,no-resolve
  - RULE-SET,disney-classical,Streaming
  - RULE-SET,spotify-classical,Streaming
  - RULE-SET,microsoft-classical,Microsoft
  - RULE-SET,apple-classical,Apple
  - RULE-SET,apple-domain,Apple
  - RULE-SET,gfw-classical,Proxy
  - RULE-SET,gfw-domain,Proxy
  - RULE-SET,cn-classical,DIRECT
  - RULE-SET,cn-domain,DIRECT
  - RULE-SET,cn-ip,DIRECT
  - GEOIP,CN,DIRECT
  - MATCH,Proxy

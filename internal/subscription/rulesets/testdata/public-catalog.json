{
  "sources": {
    "acl4ssr": {
      "name": "ACL4SSR/ACL4SSR",
      "homepage": "https://github.com/ACL4SSR/ACL4SSR",
      "license": "CC-BY-SA-4.0. Referenced by URL only.",
      "order": 50,
      "description": {
        "en": "ACL4SSR lists used by subconverter (Clash/ and Clash/Ruleset/ .list files); Surge-compatible syntax.",
        "zh-CN": "subconverter 常用的 ACL4SSR 规则（Clash/ 与 Clash/Ruleset/ 下的 .list）；语法与 Surge 兼容。"
      },
      "clients": [
        "clash-meta",
        "stash",
        "surge",
        "surfboard",
        "loon"
      ]
    },
    "blackmatrix7": {
      "name": "blackmatrix7/ios_rule_script",
      "homepage": "https://github.com/blackmatrix7/ios_rule_script",
      "license": "GPL-2.0. Rule data is aggregated from public sources; ggboard only references the raw URLs (clients download them), nothing is vendored.",
      "order": 10,
      "description": {
        "en": "Largest per-service rule collection for Clash, Surge, Quantumult X, Shadowrocket and Loon, updated daily; it has no sing-box files, so sing-box subscriptions use MetaCubeX.",
        "zh-CN": "最全的分应用规则（Clash / Surge / Quantumult X / Shadowrocket / Loon），每日更新；没有 sing-box 文件，sing-box 订阅自动改用 MetaCubeX。"
      },
      "clients": [
        "clash-meta",
        "stash",
        "surge",
        "surfboard",
        "loon",
        "quantumultx"
      ]
    },
    "dustinwin": {
      "name": "DustinWin/ruleset_geodata",
      "homepage": "https://github.com/DustinWin/ruleset_geodata",
      "license": "GPL-3.0. Referenced by URL only.",
      "order": 60,
      "description": {
        "en": "Curated mihomo / sing-box rule sets (branches mihomo-ruleset and sing-box-ruleset); domain sets and *ip sets are separate files.",
        "zh-CN": "为 mihomo / sing-box 定制的精选规则集（mihomo-ruleset、sing-box-ruleset 分支），域名集与 *ip 集分开。"
      },
      "clients": [
        "clash-meta",
        "stash",
        "singbox"
      ]
    },
    "loyalsoldier": {
      "name": "Loyalsoldier/clash-rules",
      "homepage": "https://github.com/Loyalsoldier/clash-rules",
      "license": "GPL-3.0. Referenced by URL only.",
      "order": 30,
      "description": {
        "en": "Classic Clash rule providers (release branch, built daily); the .txt files contain YAML payloads.",

      },
      "clients": [
        "clash-meta",
        "stash"
      ]
    },
    "metacubex": {
      "name": "MetaCubeX/meta-rules-dat",
      "homepage": "https://github.com/MetaCubeX/meta-rules-dat",
      "license": "GPL-3.0. Built from v2fly/domain-list-community (MIT) and public GeoIP data; referenced by URL only.",
      "order": 20,
      "description": {
        "en": "Official mihomo geosite/geoip rule sets: .mrs/.yaml on branch meta, .srs/.json on branch sing; fastest option.",
        "zh-CN": "mihomo 官方 geosite/geoip 规则集：meta 分支提供 .mrs/.yaml，sing 分支提供 .srs/.json；速度最快。"
      },
      "clients": [
        "clash-meta",
        "stash",
        "singbox"
      ]
    },
    "sagernet": {
      "name": "SagerNet/sing-geosite + SagerNet/sing-geoip",
      "homepage": "https://github.com/SagerNet/sing-geosite",
      "license": "GPL-3.0-or-later (per LICENSE file; GitHub shows NOASSERTION). Data from v2fly/domain-list-community and GeoIP databases; referenced by URL only.",
      "order": 40,
      "description": {

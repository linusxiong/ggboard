# Copy to .env (gitignored). All settings can also be given as GGBOARD_* env vars.
GGBOARD_SERVER_ADDR=:8080
GGBOARD_DATABASE_DRIVER=sqlite
# SQLite file. Leave it unset: the default is <data_dir>/ggboard.db, i.e. /data/ggboard.db in Docker and ./data/ggboard.db
# when run from source. A relative path is resolved against the working directory, which is /data in the container,
# so `./data/ggboard.db` would point at /data/data/ggboard.db and fail to open. Required for postgres / mysql.
# GGBOARD_DATABASE_DSN=
# Session signing key. Leave it unset to have a random one generated and kept in <data_dir>/jwt.secret (0600);
# to set it yourself use 32+ random bytes, e.g. `openssl rand -hex 32`. Placeholders and short values are refused.
# GGBOARD_JWT_SECRET=
GGBOARD_LOG_LEVEL=info

# Only read by deploy/docker-compose.prebuilt.yml (also passed to the container, where it is ignored):
# image tag to run, e.g. 0.1.0, 0.1, latest, main. Pin a release in production; `latest` exists only after the first stable
# release is built. GGBOARD_IMAGE swaps the registry path.
# GGBOARD_VERSION=main
# GGBOARD_IMAGE=ghcr.io/linusxiong/ggboard

# Copy to .env (gitignored). All settings can also be given as GGBOARD_* env vars.
GGBOARD_SERVER_ADDR=:8080
GGBOARD_DATABASE_DRIVER=sqlite
# SQLite file. Leave it unset: the default is <data_dir>/ggboard.db, i.e. /data/ggboard.db in Docker and ./data/ggboard.db
# when run from source. A relative path is resolved against the working directory, which is /data in the container,
# so `./data/ggboard.db` would point at /data/data/ggboard.db and fail to open. Required for postgres / mysql.
# GGBOARD_DATABASE_DSN=
# PostgreSQL instead (move existing data first with `ggboard db copy`, docs/DEPLOY.md section 5). URL-encode the password;
# sslmode=disable only on the same host or Docker network:
# GGBOARD_DATABASE_DRIVER=postgres
# GGBOARD_DATABASE_DSN=postgres://ggboard:<url-encoded password>@db.example.com:5432/ggboard?sslmode=require
# Password of the optional `postgres` service of deploy/docker-compose.prebuilt.yml (--profile postgres); its DSN host is
# `postgres`: postgres://ggboard:<this password>@postgres:5432/ggboard?sslmode=disable
# GGBOARD_POSTGRES_PASSWORD=
# Session signing key. Leave it unset to have a random one generated and kept in <data_dir>/jwt.secret (0600);
# to set it yourself use 32+ random bytes, e.g. `openssl rand -hex 32`. Placeholders and short values are refused.
# GGBOARD_JWT_SECRET=
GGBOARD_LOG_LEVEL=info
# Memory on small machines (docs/DEPLOY.md section 4): concurrent argon2id password checks, 64 MiB each
# (0 = min(cores, 4)), and the Go runtime's soft memory limit (more GC near the limit; it can be exceeded).
# GGBOARD_AUTH_ARGON2_CONCURRENCY=0
# GOMEMLIMIT=600MiB

# Only read by deploy/docker-compose.prebuilt.yml (also passed to the container, where it is ignored):
# image tag to run. The Release workflow publishes every v* tag, e.g. v1.0.0 as 1.0.0, 1.0, 1 and latest (a pre-release
# such as v1.1.0-rc.1 only as 1.1.0-rc.1, never latest); a manual run of the Docker workflow on main publishes main;
# every build is also sha-<short>. Pin a release such as 1.0.1 in production. GGBOARD_IMAGE swaps the registry path.
# GGBOARD_VERSION=1.0.1
# GGBOARD_IMAGE=ghcr.io/linusxiong/ggboard

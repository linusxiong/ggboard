{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint replaces ESLint here (see README, Tooling notes). Type-aware rules run on oxlint-tsgolint, which is built on the
  // same TypeScript 7 compiler as `tsc`. Everything in the three categories below is on for the plugins that fit this
  // stack; `rules` adds what the old ESLint presets enabled from other categories and switches off what cannot be on.
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y", "promise", "vitest"],
  // The TanStack Query rules have no native port, so they run as a JS plugin. JS plugins get no type information, which
  // leaves out `@tanstack/query/no-void-query-fn` (it would silently check nothing).
  "jsPlugins": ["@tanstack/eslint-plugin-query"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "es2023": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "coverage", ".lighthouseci", ".heroui-css", "src/routeTree.gen.ts"],
  "rules": {
    // From the ESLint / typescript-eslint / react-hooks / react-refresh presets, outside the categories above.
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-useless-assignment": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",

    "react/exhaustive-deps": "warn",
    "react/incompatible-library": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["Route"] }],
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "warn",

    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/infinite-query-property-order": "error",
    "@tanstack/query/mutation-property-order": "error",
    "@tanstack/query/no-rest-destructuring": "warn",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/query/stable-query-client": "error",

    // Does not apply: the automatic JSX runtime needs no React import.
    "react/react-in-jsx-scope": "off",

    // Off because today's code has findings. Each one needs a look before it can be turned on.
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-await-in-loop": "off",
    "no-new": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "no-unmodified-loop-condition": "off",
    "oxc/no-map-spread": "off",
    "promise/always-return": "off",
    "promise/no-callback-in-promise": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",
    "react/no-array-index-key": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/no-unstable-nested-components": "off",
    "typescript/consistent-return": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/require-array-sort-compare": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "vitest/expect-expect": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      // Type-aware rules the typescript-eslint preset had on. JavaScript files are left out: untyped values would trip
      // the no-unsafe-* family on every line.
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "typescript/ban-ts-comment": "error",
        "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/only-throw-error": [
          "error",
          {
            "allow": [
              { "from": "package", "package": "@tanstack/router-core", "name": ["Redirect", "NotFoundError"] }
            ]
          }
        ],
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": "error"
      }
    },
    {
      // TanStack Router handles HMR for route files (they export `Route` next to their split component).
      "files": ["src/routes/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      "files": ["vite.config.ts", "scripts/**", "*.cjs"],
      "env": { "node": true }
    },
    {
      "files": ["**/*.{js,cjs,mjs}"],
      "rules": { "no-undef": "error" }
    }
  ]
}

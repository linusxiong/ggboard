{
  "name": "ggboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "GG Bond panel frontend (React + HeroUI v3 + TanStack)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-css-vars.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode lighthouse",
    "typecheck": "node scripts/gen-routes.mjs && tsc -b",
    "lint": "node scripts/gen-routes.mjs && oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/gen-routes.mjs && vitest run",
    "test:watch": "vitest",
    "lh": "pnpm build && pnpm run lh:desktop && pnpm run lh:mobile",
    "lh:mobile": "LH_PRESET=mobile lhci autorun --config=./lighthouserc.cjs",
    "routes": "node scripts/gen-routes.mjs",
    "lh:desktop": "LH_PRESET=desktop lhci autorun --config=./lighthouserc.cjs",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "ui:diff": "node scripts/ui-diff.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.78.0",
    "marked": "^18.2.1",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.108.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4",
    "vitest": "^5.1.0"
  }
}

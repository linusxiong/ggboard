{
  "name": "ggboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "GG Bond panel frontend (React + HeroUI v3 + TanStack)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode lighthouse",
    "typecheck": "node scripts/gen-routes.mjs && tsc -b",
    "lint": "node scripts/gen-routes.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/gen-routes.mjs && vitest run",
    "test:watch": "vitest",
    "lh": "vite build && lhci autorun --config=./lighthouserc.cjs",
    "lh:mobile": "vite build && LH_PRESET=mobile lhci autorun --config=./lighthouserc.cjs",
    "routes": "node scripts/gen-routes.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "motion": "^14.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.5"
  }
}
